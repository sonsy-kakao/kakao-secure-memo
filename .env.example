# 이 파일을 .env 로 복사한 뒤 값을 채우세요.  (.env 는 절대 커밋하지 않습니다)
#   cp .env.example .env && chmod 600 .env
# 랜덤 값 생성 예: openssl rand -base64 48

# Docker Hub 이미지 경로 (운영 서버에서 pull 할 때 사용)
DOCKERHUB_USERNAME=your-dockerhub-id
IMAGE_TAG=latest

# DB
DB_NAME=memo
DB_USER=memo_app
DB_PASSWORD=change-me-strong-random
DB_ROOT_PASSWORD=change-me-another-strong-random

# 토큰 서명 키 (32바이트 이상 랜덤)
JWT_SECRET=change-me-64-chars-random

# auto: HTTPS 요청이면 Secure 플래그 자동 / true: 항상 / false: 사용 안 함
COOKIE_SECURE=auto

# 채점용 테스트 계정 (평가 지시서 요구사항)
SEED_USERNAME=tester
SEED_PASSWORD=test1234!

# 메인 화면에 표시될 응시자 정보 (DB에 저장되어 조회됨)
OWNER_NAME=홍길동
OWNER_GITHUB_ID=your-github-id
